<?xml version="1.0" ?>
<ForceField>
<Residues>
<Residue name="LE1">
      <!-- Penicillamine (青霉胺, 3-mercapto-valine). 侧链 Cβ(带SG3) 双甲基 CG1/CG2.
           参数来源: GROMACS CHARMM36 (charmm36-jul2022.ff/aminoacids.rtp) 官方模板.
           HG3(hydrogen on SG3) 为 leaving 原子: SG3 参与二硫键(如 LE1-CYS)时不加,
           等价于 CYS 的 CYX 变体; PDBFixer 模板注册按 leaving 标记自动处理. -->
      <Atom charge="-0.47" name="N" type="NH1"/>
      <Atom charge="0.31" name="HN" type="H"/>
      <Atom charge="0.07" name="CA" type="CT1"/>
      <Atom charge="0.09" name="HA" type="HB1"/>
      <Atom charge="0.107" name="CB" type="CG301"/>
      <Atom charge="-0.279" name="SG3" type="SG311"/>
      <Atom charge="0.114" name="HG3" type="HGP3"/>
      <Atom charge="-0.241" name="CG1" type="CG331"/>
      <Atom charge="0.09" name="HG11" type="HGA3"/>
      <Atom charge="0.09" name="HG12" type="HGA3"/>
      <Atom charge="0.09" name="HG13" type="HGA3"/>
      <Atom charge="-0.241" name="CG2" type="CG331"/>
      <Atom charge="0.09" name="HG21" type="HGA3"/>
      <Atom charge="0.09" name="HG22" type="HGA3"/>
      <Atom charge="0.09" name="HG23" type="HGA3"/>
      <Atom charge="0.51" name="C" type="C"/>
      <Atom charge="-0.51" name="O" type="O"/>
      <Bond atomName1="N" atomName2="HN"/>
      <Bond atomName1="N" atomName2="CA"/>
      <Bond atomName1="C" atomName2="CA"/>
      <Bond atomName1="CA" atomName2="HA"/>
      <Bond atomName1="CA" atomName2="CB"/>
      <Bond atomName1="CB" atomName2="SG3"/>
      <Bond atomName1="SG3" atomName2="HG3"/>
      <Bond atomName1="CB" atomName2="CG1"/>
      <Bond atomName1="CB" atomName2="CG2"/>
      <Bond atomName1="CG1" atomName2="HG11"/>
      <Bond atomName1="CG1" atomName2="HG12"/>
      <Bond atomName1="CG1" atomName2="HG13"/>
      <Bond atomName1="CG2" atomName2="HG21"/>
      <Bond atomName1="CG2" atomName2="HG22"/>
      <Bond atomName1="CG2" atomName2="HG23"/>
      <Bond atomName1="O" atomName2="C"/>
      <ExternalBond atomName="N"/>
      <ExternalBond atomName="C"/>
      <AllowPatch name="NTER"/>
      <AllowPatch name="ACE"/>
      <AllowPatch name="NNEU"/>
      <AllowPatch name="CTER"/>
      <AllowPatch name="CNEU"/>
      <AllowPatch name="CT1"/>
      <AllowPatch name="CT2"/>
      <AllowPatch name="CT3"/>
    </Residue>
  <!-- SAR: 肌氨酸 (Sarcosine, N-甲基甘氨酸). N 为叔胺(无 H), 连 N-CH3(CN).
       参数参考 OpenMM charmm36.xml 官方 MGY 模板(观查两者原子名/电荷/键完全一致:
       N(N,-0.35)/CN(CT3,-0.09)/CA(CT2,0.08)/HA1,2(HB2)/C/O 及 N-甲基 3H). -->
  <Residue name="SAR">
      <Atom charge="-0.35" name="N" type="N"/>
      <Atom charge="-0.09" name="CN" type="CT3"/>
      <Atom charge="0.09" name="HN1" type="HA3"/>
      <Atom charge="0.09" name="HN2" type="HA3"/>
      <Atom charge="0.09" name="HN3" type="HA3"/>
      <Atom charge="0.08" name="CA" type="CT2"/>
      <Atom charge="0.09" name="HA1" type="HB2"/>
      <Atom charge="0.09" name="HA2" type="HB2"/>
      <Atom charge="0.43" name="C" type="C"/>
      <Atom charge="-0.52" name="O" type="O"/>
      <Bond atomName1="N" atomName2="CN"/>
      <Bond atomName1="CN" atomName2="HN1"/>
      <Bond atomName1="CN" atomName2="HN2"/>
      <Bond atomName1="CN" atomName2="HN3"/>
      <Bond atomName1="N" atomName2="CA"/>
      <Bond atomName1="CA" atomName2="C"/>
      <Bond atomName1="CA" atomName2="HA1"/>
      <Bond atomName1="CA" atomName2="HA2"/>
      <Bond atomName1="C" atomName2="O"/>
      <ExternalBond atomName="N"/>
      <ExternalBond atomName="C"/>
    </Residue>
  <!-- MLE: N-甲基亮氨酸 (N-methyl-leucine). LEU 骨架/侧链 + N 上 N-CH3(CN).
       与 SAR 同为叔酰胺 N: 主链 N 用 N 类型(参考官方 MGY 模板), CN-CT3, 无 HN.
       注意(2026-09-28 修复): 初版 N 用 NG2S1(抄 NMA)、CG 用 CT2(抄错),
       导致 N-CA 与 CG-HG 键型(NG2S1-CT1 / HA1-CT2)在力场无参数, relax 断键.
       现按"MGY 骨架 + LEU 侧链(官方 CG=CT1)"对齐, 全部键/角命中官方参数表. -->
  <Residue name="MLE">
      <Atom charge="-0.35" name="N" type="N"/>
      <Atom charge="-0.09" name="CN" type="CT3"/>
      <Atom charge="0.09" name="HN1" type="HA3"/>
      <Atom charge="0.09" name="HN2" type="HA3"/>
      <Atom charge="0.09" name="HN3" type="HA3"/>
      <Atom charge="0.08" name="CA" type="CT2"/>
      <Atom charge="0.09" name="HA" type="HB2"/>
      <Atom charge="-0.18" name="CB" type="CT2"/>
      <Atom charge="0.09" name="HB1" type="HA2"/>
      <Atom charge="0.09" name="HB2" type="HA2"/>
      <Atom charge="-0.09" name="CG" type="CT1"/>
      <Atom charge="0.09" name="HG" type="HA1"/>
      <Atom charge="-0.27" name="CD1" type="CT3"/>
      <Atom charge="0.09" name="HD11" type="HA3"/>
      <Atom charge="0.09" name="HD12" type="HA3"/>
      <Atom charge="0.09" name="HD13" type="HA3"/>
      <Atom charge="-0.27" name="CD2" type="CT3"/>
      <Atom charge="0.09" name="HD21" type="HA3"/>
      <Atom charge="0.09" name="HD22" type="HA3"/>
      <Atom charge="0.09" name="HD23" type="HA3"/>
      <Atom charge="0.43" name="C" type="C"/>
      <Atom charge="-0.52" name="O" type="O"/>
      <Bond atomName1="N" atomName2="CN"/>
      <Bond atomName1="CN" atomName2="HN1"/>
      <Bond atomName1="CN" atomName2="HN2"/>
      <Bond atomName1="CN" atomName2="HN3"/>
      <Bond atomName1="N" atomName2="CA"/>
      <Bond atomName1="CA" atomName2="C"/>
      <Bond atomName1="CA" atomName2="HA"/>
      <Bond atomName1="CA" atomName2="CB"/>
      <Bond atomName1="CB" atomName2="HB1"/>
      <Bond atomName1="CB" atomName2="HB2"/>
      <Bond atomName1="CB" atomName2="CG"/>
      <Bond atomName1="CG" atomName2="HG"/>
      <Bond atomName1="CG" atomName2="CD1"/>
      <Bond atomName1="CG" atomName2="CD2"/>
      <Bond atomName1="CD1" atomName2="HD11"/>
      <Bond atomName1="CD1" atomName2="HD12"/>
      <Bond atomName1="CD1" atomName2="HD13"/>
      <Bond atomName1="CD2" atomName2="HD21"/>
      <Bond atomName1="CD2" atomName2="HD22"/>
      <Bond atomName1="CD2" atomName2="HD23"/>
      <Bond atomName1="C" atomName2="O"/>
      <ExternalBond atomName="N"/>
      <ExternalBond atomName="C"/>
    </Residue>
</Residues>
  <!-- LE1 缺失的键/角参数: OpenMM charmm36.xml 未包含 LE1 的 CA-CB(CT1-CG301) 与
       CB-SG3(CG301-SG311) 键参数及其角度(缺失时 OpenMM 静默跳过, minimize 会因
       LJ 排斥把无键的 CB 推开, 导致 CA-CB 键断裂).
       参数来源: GROMACS charmm36-jul2022.ff/ffbonded.itp (注释为 LE1, by ac_aa). -->
  <HarmonicBondForce>
    <Bond k="186188.00" length="0.15000000" type1="CT1" type2="CG301"/>
    <Bond k="165117.38" length="0.18494000" type1="CG301" type2="SG311"/>
    <!-- LE1SS 二硫 patch 中 LE1 侧 SG3(SG311)->SM, 补 CG301-SM (CB-SG3 二硫态键).
         参考 CHARMM36 CYS2 的 CT2-SM 键参数(同 C-S 键长, ALLOW SUL ION). -->
    <Bond k="179075.20" length="0.18160000" type1="CG301" type2="SM"/>
  </HarmonicBondForce>
  <HarmonicAngleForce>
    <Angle k="435.136" angle="1.8849555921538759" type1="C" type2="CT1" type3="CG301"/>
    <Angle k="585.760" angle="1.9809487010135638" type1="CG301" type2="CT1" type3="NH1"/>
    <Angle k="289.533" angle="1.9216075064457567" type1="HB1" type2="CT1" type3="CG301"/>
    <Angle k="488.273" angle="1.9809487010135638" type1="CT1" type2="CG301" type3="CG331"/>
    <Angle k="534.966" angle="1.9064115850906407" type1="CT1" type2="CG301" type3="SG311"/>
    <Angle k="534.966" angle="1.9064115850906407" type1="CG331" type2="CG301" type3="SG311"/>
    <Angle k="324.678" angle="1.6580630886788494" type1="CG301" type2="SG311" type3="HGP3"/>
    <Angle k="279.742" angle="1.9216075064457567" type1="CG301" type2="CG331" type3="HGA3"/>
    <!-- LE1SS 二硫 patch 后补的角度(SM 取代 SG311).
         CT1-CG301-SM / CG331-CG301-SM 参考 SG311 版同值; CG301-SM-SM 参考 CT2-SM-SM. -->
    <Angle k="534.966" angle="1.9064115850906407" type1="CT1" type2="CG301" type3="SM"/>
    <Angle k="534.966" angle="1.9064115850906407" type1="CG331" type2="CG301" type3="SM"/>
    <Angle k="606.680" angle="1.8029251173101424" type1="CG301" type2="SM" type3="SM"/>
    <Angle k="606.680" angle="1.8029251173101424" type1="SM" type2="SM" type3="CT2"/>
  </HarmonicAngleForce>
<Patches>
    <!-- LE1-CYS 二硫键 patch(仿照 CYS 的 DISU):
         拓扑中 SG3-SG 已有键且无氢时, RemoveAtom 去掉两侧巯基氢(HG3/HG1),
         把 SG3/SG 改为 SM 原子类型(CHARMM36 二硫硫), 电荷按 GMX CYS2 惯例:
         SG -0.08, 并微调 CB 电荷使侧链净电荷与 LE1 一致(0.107-0.279+0.114 →
         0.022-0.08; CG1/CG2 及其 H 不变). -->
    <Patch name="LE1SS" residues="2">
      <RemoveAtom name="1:HG3"/>
      <RemoveAtom name="2:HG1"/>
      <!-- LE1-CYS 二硫: 两侧 SG->SM(SM-SM 二硫键已有参数).
           LE1 侧 CB 保持 CG301(符合 LE1 官方定义, 补 CG301-SM 键);
           CYS 侧 CB->CT2(与 DISU 一致, CT2-SM 已有参数). -->
      <ChangeAtom charge="0.022" name="1:CB" type="CG301"/>
      <ChangeAtom charge="-0.1" name="2:CB" type="CT2"/>
      <ChangeAtom charge="-0.08" name="1:SG3" type="SM"/>
      <ChangeAtom charge="-0.08" name="2:SG" type="SM"/>
      <AddBond atomName1="1:SG3" atomName2="2:SG"/>
      <ApplyToResidue name="1:LE1"/>
      <ApplyToResidue name="2:CYS"/>
    </Patch>
  </Patches>
</ForceField>